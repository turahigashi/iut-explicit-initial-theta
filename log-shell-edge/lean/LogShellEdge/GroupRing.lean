import Mathlib

/-!
# The group-ring identities in the proof of Theorem 6.5

This file formalizes the algebraic core of steps (2)–(4) and (6) of the proof of Theorem 6.5 of the note
(for a finite extension of `ℚ_p`, `p` odd, of odd degree `d ≥ 3`, there is an automorphism `φ` of its absolute
Galois group with `φ₊(y₁) ≡ y₁ + y₂` and `φ₊(yᵢ) ≡ yᵢ` for `2 ≤ i ≤ d`, modulo `pΛ`):

* step (2): the adjoint rule `B(au, v) ≡ B(u, a†v) (mod I₀M₂)` for a group element `a`
  (`adjRule_of_unit`), and on the subalgebra generated by group elements (`adjRule_of_mem_adjoin`);
* step (3): `χ₀(c) = 0`, that is `c ∈ I₀`, and `ε(c) = 1` for `c = (ρ₀ - χ₀(ρ₀)) / (1 - χ₀(ρ₀))`
  (`c_spec`, `c_mem_ker`), and `ε(μ) = ε(ν) = 0` (`eps_mu`, `eps_nu`);
* step (4): the identity `E ≡ 0 (mod I₀M₂)` (`E_mem`), and the solution of `θζ = -E` once `I₀ ⊆ θR`
  (`exists_zeta`);
* step (6): `R` acts on the coinvariants `M₁/(ker ε)M₁` through `ε` (`smul_sub_smul_mem_kerSmul`,
  `mk_smul_eq`), so the endomorphism `x̄₁ ↦ x̄₁ + c x̄₂`, `x̄₃ ↦ x̄₃ + μ x̄₁ + ν x̄₂` of `M₁` induces
  `ȳ₁ ↦ ȳ₁ + ȳ₂`, `ȳ₃ ↦ ȳ₃` on the coinvariants (`coinv_action`, `mapQ_action`). For the free module on
  `x̄₀, …, x̄_d` and the `c, μ, ν` of step (3), the same holds, with the other `ȳᵢ` fixed, on `M₁/(ker ε)M₁`
  (`coinv_action_basis`) and on `(V/V^(2))_𝒢 = M₁/(Rθx̄₀ + (ker ε)M₁)` (`relCoinv_action_basis`).

## Setting (the notation of §6.2 of the note)

* `R` is a ring and an algebra over a field `k`, with two `k`-algebra maps `ε, χ₀ : R → k`. In the note
  `R = 𝔽_p[[𝒢]]` and `k = 𝔽_p` (in this file `k` is this coefficient field, not the local field of the note);
  `ε` is the augmentation, `χ₀` is the ring homomorphism `g ↦ χ₀(g)` given by the character `χ₀` of step (2),
  and `I₀ = ker χ₀`.
* `dag : R → R` is the anti-automorphism `†` of step (2), with `g† = χ₀(g) g⁻¹` for `g ∈ 𝒢`. Each statement
  assumes only those properties of `†` that it uses; all of them hold in the note.
* `M₁ = P/P^(2)` and `M₂ = P^(2)/P^(3)` are left `R`-modules, `B : M₁ × M₁ → M₂` is the commutator pairing and
  `π : M₁ → M₂` is the `p`-th power map. That `B` is biadditive and alternating with `B(gu, gv) = g B(u, v)`,
  and that `π` is `R`-linear (`p` odd), are hypotheses here, as in §6.2 of the note. The note uses these
  identities only for `s = 1` (Theorem 6.5 assumes `s(k) = 1`): the first term of `E` is then `p c x̄₂`, the
  image of `π (c • x̄₂)`. For `s ≥ 2` the identity itself would still hold, but the lifting theorem is then not
  available in the descending `p`-central form used in step (5) (see the remark after Theorem 6.3).
* `kerSmul f M` is the submodule `(ker f) M` of `M`. Thus `kerSmul χ₀ M₂ = I₀M₂`, and `M₁ ⧸ kerSmul ε M₁` is
  the module of coinvariants of `M₁`.

In `E_mem` the adjoint rule is a hypothesis for every `a ∈ R`. It is derived here for group elements and
the subalgebra that they generate (for a finite group `𝒢` this subalgebra is all of `R = 𝔽_p[𝒢]`); its
extension to the completed group ring `𝔽_p[[𝒢]]` uses continuity and is not formalized.

## Not formalized

The passage from these identities to an automorphism of the Galois group: step (1) and the computation
`ψ(r) r⁻¹ ≡ E (mod P^(3))` (the presentation calculus in the free pro-`p` operator group), and step (5)
(Wingberg's lifting theorem for `s = 1`, Theorem 6.3 of the note, [NSW, Thm. 7.5.15], [Nishio26,
Prop. 2.6]). Also not formalized are the
identification `θR = I₀` of step (2) (`exists_zeta` assumes `I₀ ⊆ θR`), the fact that the image of the
relation `r` in `M₁` is `θ x̄₀` (Proposition 6.4 (iii) of the note), and the isomorphism
`(V/V^(2))_𝒢 ≅ Λ/pΛ`, `x̄ᵢ ↦ ȳᵢ`.
-/

set_option autoImplicit false

noncomputable section

namespace LogShellEdge.GroupRing

variable {k R : Type*} [Field k] [Ring R] [Algebra k R]

/-! ## The submodules `(ker f) M` -/

/-- The submodule `(ker f) M` of an `R`-module `M`, generated by all `a • m` with `f a = 0`. For `f = χ₀`
this is `I₀M`; for `f = ε`, the quotient `M ⧸ kerSmul ε M` is the module of coinvariants. -/
abbrev kerSmul (f : R →ₐ[k] k) (M : Type*) [AddCommGroup M] [Module R M] : Submodule R M :=
  RingHom.ker f • (⊤ : Submodule R M)

/-- If `f a = 0`, then `a m ∈ (ker f) M`. -/
theorem smul_mem_kerSmul {f : R →ₐ[k] k} {M : Type*} [AddCommGroup M] [Module R M] {a : R}
    (ha : f a = 0) (m : M) : a • m ∈ kerSmul f M :=
  Submodule.smul_mem_smul (RingHom.mem_ker.mpr ha) Submodule.mem_top

section Tower

variable {M : Type*} [AddCommGroup M] [Module R M] [Module k M] [IsScalarTower k R M]

/-- `R` acts on `M / (ker f) M` through `f`: `a m - f(a) m ∈ (ker f) M`. -/
theorem smul_sub_smul_mem_kerSmul (f : R →ₐ[k] k) (a : R) (m : M) :
    a • m - f a • m ∈ kerSmul f M := by
  have h : a • m - f a • m = (a - f a • (1 : R)) • m := by rw [sub_smul, smul_one_smul]
  rw [h]
  apply smul_mem_kerSmul
  rw [map_sub, map_smul, map_one, smul_eq_mul, mul_one, sub_self]

/-- If `f(a) = 1`, then `a m - m ∈ (ker f) M`. -/
theorem smul_sub_self_mem_kerSmul (f : R →ₐ[k] k) {a : R} (ha : f a = 1) (m : M) :
    a • m - m ∈ kerSmul f M := by
  have h := smul_sub_smul_mem_kerSmul f a m
  rwa [ha, one_smul] at h

/-- `R` acts through `f` on every quotient `M ⧸ Q` with `(ker f) M ⊆ Q`. -/
theorem mk_smul_eq_of_le (f : R →ₐ[k] k) {Q : Submodule R M} (hQ : kerSmul f M ≤ Q) (a : R) (m : M) :
    (Submodule.Quotient.mk (a • m) : M ⧸ Q) = f a • Submodule.Quotient.mk m := by
  rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.eq]
  exact hQ (smul_sub_smul_mem_kerSmul f a m)

/-- `R` acts on `M ⧸ (ker f) M` through `f`. -/
theorem mk_smul_eq (f : R →ₐ[k] k) (a : R) (m : M) :
    (Submodule.Quotient.mk (a • m) : M ⧸ kerSmul f M) = f a • Submodule.Quotient.mk m :=
  mk_smul_eq_of_le f le_rfl a m

end Tower

/-! ## Step (3): the element `c`, and `μ`, `ν` -/

/-- Step (3): if `ε(ρ₀) = 1` and `χ₀(ρ₀) = t ≠ 1`, then `c = (1 - t)⁻¹ (ρ₀ - t)` satisfies `χ₀(c) = 0`
and `ε(c) = 1`. -/
theorem c_spec (ε χ₀ : R →ₐ[k] k) (ρ₀ : R) (t : k) (hε : ε ρ₀ = 1) (hχ : χ₀ ρ₀ = t) (ht : t ≠ 1) :
    χ₀ ((1 - t)⁻¹ • (ρ₀ - t • 1)) = 0 ∧ ε ((1 - t)⁻¹ • (ρ₀ - t • 1)) = 1 := by
  refine ⟨?_, ?_⟩
  · simp only [map_smul, map_sub, map_one, hχ, smul_eq_mul, mul_one, sub_self, mul_zero]
  · simp only [map_smul, map_sub, map_one, hε, smul_eq_mul, mul_one]
    exact inv_mul_cancel₀ (sub_ne_zero.mpr (Ne.symm ht))

/-- Step (3): `c ∈ I₀ = ker χ₀`. -/
theorem c_mem_ker (χ₀ : R →ₐ[k] k) (ρ₀ : R) (t : k) (hχ : χ₀ ρ₀ = t) :
    (1 - t)⁻¹ • (ρ₀ - t • 1) ∈ RingHom.ker χ₀ := by
  rw [RingHom.mem_ker]
  simp only [map_smul, map_sub, map_one, hχ, smul_eq_mul, mul_one, sub_self, mul_zero]

/-- `μ = -c†(δ - δ†)` (step (3)). -/
def mu (dag : R → R) (c δ : R) : R := -(dag c * (δ - dag δ))

/-- `ν = -c†δc` (step (3)). -/
def nu (dag : R → R) (c δ : R) : R := -(dag c * δ * c)

/-- Step (3): `ε(μ) = 0`, because `ε(c†) = χ₀(c) = 0`. -/
theorem eps_mu (ε χ₀ : R →ₐ[k] k) (dag : R → R) (hdag : ∀ a, ε (dag a) = χ₀ a) (c δ : R)
    (hc : χ₀ c = 0) : ε (mu dag c δ) = 0 := by
  simp only [mu, map_neg, map_mul, hdag c, hc, zero_mul, neg_zero]

/-- Step (3): `ε(ν) = 0`, because `ε(c†) = χ₀(c) = 0`. -/
theorem eps_nu (ε χ₀ : R →ₐ[k] k) (dag : R → R) (hdag : ∀ a, ε (dag a) = χ₀ a) (c δ : R)
    (hc : χ₀ c = 0) : ε (nu dag c δ) = 0 := by
  simp only [nu, map_neg, map_mul, hdag c, hc, zero_mul, neg_zero]

section Modules

variable {M₁ M₂ : Type*} [AddCommGroup M₁] [Module R M₁] [AddCommGroup M₂] [Module R M₂]

/-- An alternating biadditive map is antisymmetric. -/
theorem antisymm_of_alt (B : M₁ →+ M₁ →+ M₂) (halt : ∀ u, B u u = 0) (u v : M₁) :
    B u v = -B v u := by
  have h := halt (u + v)
  rw [map_add B u v, AddMonoidHom.add_apply, map_add (B u), map_add (B v), halt u, halt v, zero_add,
    add_zero] at h
  exact eq_neg_of_add_eq_zero_left h

/-! ## Step (2): the adjoint rule -/

/-- The adjoint rule of step (2) for the element `a`: `B(au, v) ≡ B(u, a†v) (mod I₀M₂)` for all
`u, v ∈ M₁`. -/
def AdjRule (χ₀ : R →ₐ[k] k) (dag : R → R) (B : M₁ →+ M₁ →+ M₂) (a : R) : Prop :=
  ∀ u v : M₁, B (a • u) v - B u (dag a • v) ∈ kerSmul χ₀ M₂

/-- Step (2) for a group element `g` (a unit of `R`): if `B(gu, gv) = g B(u, v)`, `g† = χ₀(g) g⁻¹`, and `B`
is `k`-linear in the second variable, then `B(gu, v) = g B(u, g⁻¹v) ≡ χ₀(g) B(u, g⁻¹v) = B(u, g†v)`
modulo `I₀M₂`. -/
theorem adjRule_of_unit [Module k M₁] [IsScalarTower k R M₁] [Module k M₂] [IsScalarTower k R M₂]
    (χ₀ : R →ₐ[k] k) (dag : R → R) (B : M₁ →+ M₁ →+ M₂)
    (hB₂ : ∀ (t : k) (u v : M₁), B u (t • v) = t • B u v) (g : Rˣ)
    (hequiv : ∀ u v : M₁, B ((g : R) • u) ((g : R) • v) = (g : R) • B u v)
    (hg : dag g = χ₀ g • ((g⁻¹ : Rˣ) : R)) : AdjRule χ₀ dag B g := by
  intro u v
  obtain ⟨w, rfl⟩ : ∃ w : M₁, v = (g : R) • w :=
    ⟨((g⁻¹ : Rˣ) : R) • v, by rw [smul_smul, Units.mul_inv, one_smul]⟩
  have h2 : B u (dag g • (g : R) • w) = χ₀ g • B u w := by
    rw [hg, smul_assoc, smul_smul, Units.inv_mul, one_smul, hB₂]
  rw [hequiv, h2]
  exact smul_sub_smul_mem_kerSmul χ₀ (g : R) (B u w)

/-- The adjoint rule is closed under sums if `†` is additive. -/
theorem AdjRule.add {χ₀ : R →ₐ[k] k} {dag : R → R} {B : M₁ →+ M₁ →+ M₂}
    (hadd : ∀ a b, dag (a + b) = dag a + dag b) {a b : R} (ha : AdjRule χ₀ dag B a)
    (hb : AdjRule χ₀ dag B b) : AdjRule χ₀ dag B (a + b) := by
  intro u v
  have e : B ((a + b) • u) v - B u (dag (a + b) • v)
      = (B (a • u) v - B u (dag a • v)) + (B (b • u) v - B u (dag b • v)) := by
    simp only [hadd, add_smul, map_add, AddMonoidHom.add_apply]
    abel
  rw [e]
  exact add_mem (ha u v) (hb u v)

/-- The adjoint rule is closed under products if `†` is anti-multiplicative:
`B(abu, v) ≡ B(bu, a†v) ≡ B(u, b†a†v) = B(u, (ab)†v)`. -/
theorem AdjRule.mul {χ₀ : R →ₐ[k] k} {dag : R → R} {B : M₁ →+ M₁ →+ M₂}
    (hmul : ∀ a b, dag (a * b) = dag b * dag a) {a b : R} (ha : AdjRule χ₀ dag B a)
    (hb : AdjRule χ₀ dag B b) : AdjRule χ₀ dag B (a * b) := by
  intro u v
  have e : B ((a * b) • u) v - B u (dag (a * b) • v)
      = (B (a • b • u) v - B (b • u) (dag a • v))
        + (B (b • u) (dag a • v) - B u (dag b • dag a • v)) := by
    rw [hmul, mul_smul, mul_smul]
    abel
  rw [e]
  exact add_mem (ha (b • u) v) (hb u (dag a • v))

/-- The adjoint rule holds for the scalars `t · 1` if `B` is `k`-bilinear and `†` is `k`-linear with
`1† = 1`. -/
theorem adjRule_algebraMap [Module k M₁] [IsScalarTower k R M₁] [Module k M₂]
    (χ₀ : R →ₐ[k] k) (dag : R → R) (B : M₁ →+ M₁ →+ M₂)
    (hB₁ : ∀ (t : k) (u v : M₁), B (t • u) v = t • B u v)
    (hB₂ : ∀ (t : k) (u v : M₁), B u (t • v) = t • B u v)
    (hdag₁ : dag 1 = 1) (hdagk : ∀ (t : k) (a : R), dag (t • a) = t • dag a) (t : k) :
    AdjRule χ₀ dag B (algebraMap k R t) := by
  intro u v
  rw [Algebra.algebraMap_eq_smul_one, hdagk, hdag₁, smul_one_smul, smul_one_smul, hB₁, hB₂,
    sub_self]
  exact zero_mem _

/-- Step (2): the adjoint rule holds on the `k`-subalgebra of `R` generated by a set `S` of group elements
(units `g` with `B(gu, gv) = g B(u, v)` and `g† = χ₀(g) g⁻¹`), if `B` is `k`-bilinear and `†` is additive,
anti-multiplicative and `k`-linear with `1† = 1`. -/
theorem adjRule_of_mem_adjoin [Module k M₁] [IsScalarTower k R M₁] [Module k M₂]
    [IsScalarTower k R M₂] (χ₀ : R →ₐ[k] k) (dag : R → R) (B : M₁ →+ M₁ →+ M₂)
    (hB₁ : ∀ (t : k) (u v : M₁), B (t • u) v = t • B u v)
    (hB₂ : ∀ (t : k) (u v : M₁), B u (t • v) = t • B u v)
    (hadd : ∀ a b, dag (a + b) = dag a + dag b) (hmul : ∀ a b, dag (a * b) = dag b * dag a)
    (hdag₁ : dag 1 = 1) (hdagk : ∀ (t : k) (a : R), dag (t • a) = t • dag a) (S : Set Rˣ)
    (hS : ∀ g ∈ S, (∀ u v : M₁, B ((g : R) • u) ((g : R) • v) = (g : R) • B u v) ∧
      dag g = χ₀ g • ((g⁻¹ : Rˣ) : R))
    {a : R} (ha : a ∈ Algebra.adjoin k ((fun g : Rˣ => (g : R)) '' S)) : AdjRule χ₀ dag B a := by
  induction ha using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨g, hgS, rfl⟩ := hx
    exact adjRule_of_unit χ₀ dag B hB₂ g (hS g hgS).1 (hS g hgS).2
  | algebraMap t => exact adjRule_algebraMap χ₀ dag B hB₁ hB₂ hdag₁ hdagk t
  | add x y _ _ hx hy => exact AdjRule.add hadd hx hy
  | mul x y _ _ hx hy => exact AdjRule.mul hmul hx hy

/-! ## Step (4): the change of the relation -/

/-- The element `E ∈ M₂` of step (4), for the `p`-th power map `π` and the commutator pairing `B`:
`E = π(c x₂) + B(x₁, δc x₂) + B(c x₂, δ x₁) + B(c x₂, δc x₂) + B(x₂, μ x₁) + B(x₂, ν x₂)`. -/
def E (π : M₁ →ₗ[R] M₂) (B : M₁ →+ M₁ →+ M₂) (dag : R → R) (c δ : R) (x₁ x₂ : M₁) : M₂ :=
  π (c • x₂) + B x₁ ((δ * c) • x₂) + B (c • x₂) (δ • x₁) + B (c • x₂) ((δ * c) • x₂)
    + B x₂ (mu dag c δ • x₁) + B x₂ (nu dag c δ • x₂)

/-- Step (4): `E ∈ I₀M₂`. Modulo `I₀M₂`, by the adjoint rule and the alternation of `B`,
`B(x₁, δc x₂) ≡ -B(x₂, c†δ† x₁)`, `B(c x₂, δ x₁) ≡ B(x₂, c†δ x₁)` and `B(c x₂, δc x₂) ≡ B(x₂, c†δc x₂)`;
these cancel against `B(x₂, μ x₁)` and `B(x₂, ν x₂)`, and `π(c x₂) = c π(x₂) ∈ I₀M₂` as `c ∈ I₀`. -/
theorem E_mem (χ₀ : R →ₐ[k] k) (dag : R → R) (hmul : ∀ a b, dag (a * b) = dag b * dag a)
    (π : M₁ →ₗ[R] M₂) (B : M₁ →+ M₁ →+ M₂) (halt : ∀ u, B u u = 0)
    (hadj : ∀ a, AdjRule χ₀ dag B a) (c δ : R) (hc : χ₀ c = 0) (x₁ x₂ : M₁) :
    E π B dag c δ x₁ x₂ ∈ kerSmul χ₀ M₂ := by
  have h0 : π (c • x₂) ∈ kerSmul χ₀ M₂ := by
    rw [map_smul]
    exact smul_mem_kerSmul hc _
  have h1 := hadj (δ * c) x₂ x₁
  have h2 := hadj c x₂ (δ • x₁)
  have h3 := hadj c x₂ ((δ * c) • x₂)
  have e1 : B x₁ ((δ * c) • x₂) = -B ((δ * c) • x₂) x₁ := antisymm_of_alt B halt _ _
  have e2 : B x₂ (mu dag c δ • x₁) = B x₂ (dag (δ * c) • x₁) - B x₂ (dag c • δ • x₁) := by
    have hμ : mu dag c δ = dag (δ * c) - dag c * δ := by
      rw [hmul, mu, mul_sub, neg_sub]
    rw [hμ, sub_smul, map_sub, smul_smul]
  have e3 : B x₂ (nu dag c δ • x₂) = -B x₂ (dag c • (δ * c) • x₂) := by
    rw [nu, neg_smul, map_neg, smul_smul, mul_assoc]
  have key : E π B dag c δ x₁ x₂ = π (c • x₂) - (B ((δ * c) • x₂) x₁ - B x₂ (dag (δ * c) • x₁))
      + (B (c • x₂) (δ • x₁) - B x₂ (dag c • δ • x₁))
      + (B (c • x₂) ((δ * c) • x₂) - B x₂ (dag c • (δ * c) • x₂)) := by
    rw [E, e1, e2, e3]
    abel
  rw [key]
  exact add_mem (add_mem (sub_mem h0 h1) h2) h3

/-- If `I₀ ⊆ θR`, then every element of `I₀M` has the form `θζ` (so `I₀M = θM`). -/
theorem exists_theta_smul_eq (χ₀ : R →ₐ[k] k) (θ : R) (hθ : ∀ a, χ₀ a = 0 → ∃ r, a = θ * r)
    {M : Type*} [AddCommGroup M] [Module R M] {m : M} (hm : m ∈ kerSmul χ₀ M) :
    ∃ ζ : M, θ • ζ = m := by
  refine Submodule.smul_induction_on hm (fun a ha n _ => ?_) (fun x y hx hy => ?_)
  · obtain ⟨r, rfl⟩ := hθ a (RingHom.mem_ker.mp ha)
    exact ⟨r • n, smul_smul θ r n⟩
  · obtain ⟨ζ₁, rfl⟩ := hx
    obtain ⟨ζ₂, rfl⟩ := hy
    exact ⟨ζ₁ + ζ₂, smul_add θ ζ₁ ζ₂⟩

/-- Step (4), end: if `I₀ ⊆ θR` (step (2)), there is `ζ ∈ M₂` with `θζ = -E`. -/
theorem exists_zeta (χ₀ : R →ₐ[k] k) (dag : R → R) (hmul : ∀ a b, dag (a * b) = dag b * dag a)
    (π : M₁ →ₗ[R] M₂) (B : M₁ →+ M₁ →+ M₂) (halt : ∀ u, B u u = 0)
    (hadj : ∀ a, AdjRule χ₀ dag B a) (c δ : R) (hc : χ₀ c = 0) (x₁ x₂ : M₁) (θ : R)
    (hθ : ∀ a, χ₀ a = 0 → ∃ r, a = θ * r) :
    ∃ ζ : M₂, θ • ζ = -E π B dag c δ x₁ x₂ :=
  exists_theta_smul_eq χ₀ θ hθ (neg_mem (E_mem χ₀ dag hmul π B halt hadj c δ hc x₁ x₂))

/-! ## Step (6): the action on the coinvariants -/

/-- Every `R`-linear endomorphism `φ` of `M₁` preserves `(ker f) M₁`. -/
theorem kerSmul_le_comap (f : R →ₐ[k] k) (φ : M₁ →ₗ[R] M₁) :
    kerSmul f M₁ ≤ (kerSmul f M₁).comap φ := by
  refine Submodule.smul_le.mpr fun r hr n _ => ?_
  rw [Submodule.mem_comap, map_smul]
  exact Submodule.smul_mem_smul hr Submodule.mem_top

/-- The endomorphism of the coinvariants `M₁ / (ker ε) M₁` induced by an `R`-linear endomorphism `φ` of
`M₁`. -/
def coinvMap (ε : R →ₐ[k] k) (φ : M₁ →ₗ[R] M₁) : (M₁ ⧸ kerSmul ε M₁) →ₗ[R] M₁ ⧸ kerSmul ε M₁ :=
  Submodule.mapQ _ _ φ (kerSmul_le_comap ε φ)

/-- `coinvMap ε φ` sends the class of `m` to the class of `φ m`. -/
theorem coinvMap_mk (ε : R →ₐ[k] k) (φ : M₁ →ₗ[R] M₁) (m : M₁) :
    coinvMap ε φ (Submodule.Quotient.mk m) = Submodule.Quotient.mk (φ m) :=
  Submodule.mapQ_apply _ _ _ _

section Action

variable [Module k M₁] [IsScalarTower k R M₁]

/-- Step (6), general form. Let `Q ⊆ M₁` be a submodule with `(ker ε) M₁ ⊆ Q` and `φ(Q) ⊆ Q` (for example
`Q = (ker ε) M₁`, or `relKer`, for which `M₁ ⧸ Q = (V/V^(2))_𝒢`). If `φ x₁ = x₁ + c x₂` and
`φ x₃ = x₃ + μ x₁ + ν x₂`, the map induced on `M₁ ⧸ Q` sends `x̄₁ ↦ x̄₁ + ε(c) x̄₂` and
`x̄₃ ↦ x̄₃ + ε(μ) x̄₁ + ε(ν) x̄₂`. -/
theorem mapQ_formula (ε : R →ₐ[k] k) {Q : Submodule R M₁} (hQ : kerSmul ε M₁ ≤ Q) (φ : M₁ →ₗ[R] M₁)
    (hφ : Q ≤ Q.comap φ) (c μ ν : R) (x₁ x₂ x₃ : M₁) (h₁ : φ x₁ = x₁ + c • x₂)
    (h₃ : φ x₃ = x₃ + μ • x₁ + ν • x₂) :
    Q.mapQ Q φ hφ (Submodule.Quotient.mk x₁)
        = Submodule.Quotient.mk x₁ + ε c • Submodule.Quotient.mk x₂ ∧
      Q.mapQ Q φ hφ (Submodule.Quotient.mk x₃)
        = Submodule.Quotient.mk x₃ + ε μ • Submodule.Quotient.mk x₁
          + ε ν • Submodule.Quotient.mk x₂ := by
  refine ⟨?_, ?_⟩
  · rw [Submodule.mapQ_apply, h₁, Submodule.Quotient.mk_add, mk_smul_eq_of_le ε hQ]
  · rw [Submodule.mapQ_apply, h₃, Submodule.Quotient.mk_add, Submodule.Quotient.mk_add,
      mk_smul_eq_of_le ε hQ, mk_smul_eq_of_le ε hQ]

/-- Step (6): with `ε(c) = 1` and `ε(μ) = ε(ν) = 0`, the map induced on `M₁ ⧸ Q` sends `x̄₁ ↦ x̄₁ + x̄₂`
and `x̄₃ ↦ x̄₃`. -/
theorem mapQ_action (ε : R →ₐ[k] k) {Q : Submodule R M₁} (hQ : kerSmul ε M₁ ≤ Q) (φ : M₁ →ₗ[R] M₁)
    (hφ : Q ≤ Q.comap φ) (c μ ν : R) (x₁ x₂ x₃ : M₁) (h₁ : φ x₁ = x₁ + c • x₂)
    (h₃ : φ x₃ = x₃ + μ • x₁ + ν • x₂) (hc : ε c = 1) (hμ : ε μ = 0) (hν : ε ν = 0) :
    Q.mapQ Q φ hφ (Submodule.Quotient.mk x₁) = Submodule.Quotient.mk x₁ + Submodule.Quotient.mk x₂ ∧
      Q.mapQ Q φ hφ (Submodule.Quotient.mk x₃) = Submodule.Quotient.mk x₃ := by
  obtain ⟨e₁, e₃⟩ := mapQ_formula ε hQ φ hφ c μ ν x₁ x₂ x₃ h₁ h₃
  rw [hc, one_smul] at e₁
  rw [hμ, hν, zero_smul, zero_smul, add_zero, add_zero] at e₃
  exact ⟨e₁, e₃⟩

/-- Step (6) on the coinvariants `M₁ / (ker ε) M₁`: if `φ x₁ = x₁ + c x₂` and `φ x₃ = x₃ + μ x₁ + ν x₂`
with `ε(c) = 1` and `ε(μ) = ε(ν) = 0`, the induced map sends `x̄₁ ↦ x̄₁ + x̄₂` and `x̄₃ ↦ x̄₃`. -/
theorem coinv_action (ε : R →ₐ[k] k) (φ : M₁ →ₗ[R] M₁) (c μ ν : R) (x₁ x₂ x₃ : M₁)
    (h₁ : φ x₁ = x₁ + c • x₂) (h₃ : φ x₃ = x₃ + μ • x₁ + ν • x₂)
    (hc : ε c = 1) (hμ : ε μ = 0) (hν : ε ν = 0) :
    coinvMap ε φ (Submodule.Quotient.mk x₁) = Submodule.Quotient.mk x₁ + Submodule.Quotient.mk x₂ ∧
      coinvMap ε φ (Submodule.Quotient.mk x₃) = Submodule.Quotient.mk x₃ :=
  mapQ_action ε le_rfl φ (kerSmul_le_comap ε φ) c μ ν x₁ x₂ x₃ h₁ h₃ hc hμ hν

/-- The same as membership: `φ x₁ - (x₁ + x₂)` and `φ x₃ - x₃` lie in `(ker ε) M₁`
(because `c x₂ - x₂`, `μ x₁` and `ν x₂` do). -/
theorem coinv_action_mem (ε : R →ₐ[k] k) (φ : M₁ →ₗ[R] M₁) (c μ ν : R) (x₁ x₂ x₃ : M₁)
    (h₁ : φ x₁ = x₁ + c • x₂) (h₃ : φ x₃ = x₃ + μ • x₁ + ν • x₂)
    (hc : ε c = 1) (hμ : ε μ = 0) (hν : ε ν = 0) :
    φ x₁ - (x₁ + x₂) ∈ kerSmul ε M₁ ∧ φ x₃ - x₃ ∈ kerSmul ε M₁ := by
  refine ⟨?_, ?_⟩
  · rw [h₁, add_sub_add_left_eq_sub]
    exact smul_sub_self_mem_kerSmul ε hc x₂
  · rw [h₃, add_assoc, add_sub_cancel_left]
    exact add_mem (smul_mem_kerSmul hμ x₁) (smul_mem_kerSmul hν x₂)

end Action

section Basis

variable {ι : Type*}

/-- The submodule `R θ x̄_{i₀} + (ker ε) M₁` of the free module `M₁` with basis `x̄ᵢ = b i`. When `θ x̄_{i₀}`
is the image `θ x̄₀` of the relation `r` in `M₁` (Proposition 6.4 (iii) of the note), `M₁ / R θ x̄₀` is
`V/V^(2)` and `M₁ ⧸ relKer ε b θ i₀` is the module of coinvariants `(V/V^(2))_𝒢` of step (6). -/
def relKer (ε : R →ₐ[k] k) (b : Module.Basis ι R M₁) (θ : R) (i₀ : ι) : Submodule R M₁ :=
  Submodule.span R {θ • b i₀} ⊔ kerSmul ε M₁

theorem kerSmul_le_relKer (ε : R →ₐ[k] k) (b : Module.Basis ι R M₁) (θ : R) (i₀ : ι) :
    kerSmul ε M₁ ≤ relKer ε b θ i₀ :=
  le_sup_right

variable [DecidableEq ι]

/-- The endomorphism of the free module `M₁` with basis `x̄ᵢ = b i` that sends `x̄_{i₁} ↦ x̄_{i₁} + c x̄_{i₂}`,
`x̄_{i₃} ↦ x̄_{i₃} + μ x̄_{i₁} + ν x̄_{i₂}` and fixes the other `x̄ᵢ`: the map induced on `M₁ = P/P^(2)` by
the automorphism `ψ` of step (3) (with `i₁, i₂, i₃ = 1, 2, 3`), and by `ψ'` of step (4). -/
def psiBar (b : Module.Basis ι R M₁) (i₁ i₂ i₃ : ι) (c μ ν : R) : M₁ →ₗ[R] M₁ :=
  b.constr ℕ fun i =>
    if i = i₁ then b i₁ + c • b i₂ else if i = i₃ then b i₃ + μ • b i₁ + ν • b i₂ else b i

theorem psiBar_apply_one (b : Module.Basis ι R M₁) (i₁ i₂ i₃ : ι) (c μ ν : R) :
    psiBar b i₁ i₂ i₃ c μ ν (b i₁) = b i₁ + c • b i₂ := by
  simp [psiBar]

theorem psiBar_apply_three (b : Module.Basis ι R M₁) {i₁ i₃ : ι} (i₂ : ι) (h₁₃ : i₁ ≠ i₃)
    (c μ ν : R) : psiBar b i₁ i₂ i₃ c μ ν (b i₃) = b i₃ + μ • b i₁ + ν • b i₂ := by
  simp [psiBar, Ne.symm h₁₃]

theorem psiBar_apply_other (b : Module.Basis ι R M₁) (i₁ i₂ i₃ : ι) (c μ ν : R) {i : ι}
    (h₁ : i ≠ i₁) (h₃ : i ≠ i₃) : psiBar b i₁ i₂ i₃ c μ ν (b i) = b i := by
  simp [psiBar, h₁, h₃]

/-- `ψ̄` fixes `x̄_{i₀}` (here `i₀ ∉ {i₁, i₃}`), hence preserves `relKer`. -/
theorem relKer_le_comap_psiBar (ε : R →ₐ[k] k) (b : Module.Basis ι R M₁) (θ : R) {i₀ i₁ i₃ : ι}
    (i₂ : ι) (h₀₁ : i₀ ≠ i₁) (h₀₃ : i₀ ≠ i₃) (c μ ν : R) :
    relKer ε b θ i₀ ≤ (relKer ε b θ i₀).comap (psiBar b i₁ i₂ i₃ c μ ν) := by
  refine sup_le ?_ ?_
  · rw [Submodule.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Submodule.mem_comap, map_smul,
      psiBar_apply_other b i₁ i₂ i₃ c μ ν h₀₁ h₀₃]
    exact Submodule.mem_sup_left (Submodule.mem_span_singleton_self _)
  · intro m hm
    exact Submodule.mem_comap.mpr
      (Submodule.mem_sup_right (Submodule.mem_comap.mp (kerSmul_le_comap ε _ hm)))

/-- The endomorphism of `M₁ ⧸ relKer ε b θ i₀` (that is, of `(V/V^(2))_𝒢`) induced by `ψ̄ = psiBar`. -/
def relMap (ε : R →ₐ[k] k) (b : Module.Basis ι R M₁) (θ : R) {i₀ i₁ i₃ : ι} (i₂ : ι) (h₀₁ : i₀ ≠ i₁)
    (h₀₃ : i₀ ≠ i₃) (c μ ν : R) : (M₁ ⧸ relKer ε b θ i₀) →ₗ[R] M₁ ⧸ relKer ε b θ i₀ :=
  Submodule.mapQ _ _ (psiBar b i₁ i₂ i₃ c μ ν) (relKer_le_comap_psiBar ε b θ i₂ h₀₁ h₀₃ c μ ν)

variable [Module k M₁] [IsScalarTower k R M₁]

/-- Step (6) for the free module `M₁` on `x̄ᵢ = b i` and the `c, μ, ν` of step (3) (`χ₀(c) = 0`,
`ε(c) = 1`, `μ = -c†(δ - δ†)`, `ν = -c†δc`, `ε ∘ † = χ₀`): on any quotient `M₁ ⧸ Q` with
`(ker ε) M₁ ⊆ Q` and `ψ̄(Q) ⊆ Q`, the map induced by `ψ̄ = psiBar` sends `ȳ_{i₁} ↦ ȳ_{i₁} + ȳ_{i₂}` and
fixes `ȳ_{i₃}` and every other `ȳᵢ`. -/
theorem mapQ_action_basis (ε χ₀ : R →ₐ[k] k) (dag : R → R) (hdag : ∀ a, ε (dag a) = χ₀ a)
    (b : Module.Basis ι R M₁) (i₁ i₂ i₃ : ι) (h₁₃ : i₁ ≠ i₃) (c δ : R) (hc₀ : χ₀ c = 0)
    (hc₁ : ε c = 1) {Q : Submodule R M₁} (hQ : kerSmul ε M₁ ≤ Q)
    (hφ : Q ≤ Q.comap (psiBar b i₁ i₂ i₃ c (mu dag c δ) (nu dag c δ))) :
    Q.mapQ Q _ hφ (Submodule.Quotient.mk (b i₁))
        = Submodule.Quotient.mk (b i₁) + Submodule.Quotient.mk (b i₂) ∧
      Q.mapQ Q _ hφ (Submodule.Quotient.mk (b i₃)) = Submodule.Quotient.mk (b i₃) ∧
      ∀ i, i ≠ i₁ → i ≠ i₃ →
        Q.mapQ Q _ hφ (Submodule.Quotient.mk (b i)) = Submodule.Quotient.mk (b i) := by
  obtain ⟨e₁, e₃⟩ := mapQ_action ε hQ _ hφ c (mu dag c δ) (nu dag c δ) (b i₁) (b i₂) (b i₃)
    (psiBar_apply_one b i₁ i₂ i₃ c _ _) (psiBar_apply_three b i₂ h₁₃ c _ _) hc₁
    (eps_mu ε χ₀ dag hdag c δ hc₀) (eps_nu ε χ₀ dag hdag c δ hc₀)
  refine ⟨e₁, e₃, fun i h₁ h₃ => ?_⟩
  rw [Submodule.mapQ_apply, psiBar_apply_other b i₁ i₂ i₃ c _ _ h₁ h₃]

/-- Step (6) on the coinvariants `M₁ / (ker ε) M₁`, for the free module on `x̄ᵢ = b i` and the `c, μ, ν`
of step (3): `ȳ_{i₁} ↦ ȳ_{i₁} + ȳ_{i₂}`, and `ȳ_{i₃}` and every other `ȳᵢ` are fixed. -/
theorem coinv_action_basis (ε χ₀ : R →ₐ[k] k) (dag : R → R) (hdag : ∀ a, ε (dag a) = χ₀ a)
    (b : Module.Basis ι R M₁) (i₁ i₂ i₃ : ι) (h₁₃ : i₁ ≠ i₃) (c δ : R) (hc₀ : χ₀ c = 0)
    (hc₁ : ε c = 1) :
    coinvMap ε (psiBar b i₁ i₂ i₃ c (mu dag c δ) (nu dag c δ)) (Submodule.Quotient.mk (b i₁))
        = Submodule.Quotient.mk (b i₁) + Submodule.Quotient.mk (b i₂) ∧
      coinvMap ε (psiBar b i₁ i₂ i₃ c (mu dag c δ) (nu dag c δ)) (Submodule.Quotient.mk (b i₃))
        = Submodule.Quotient.mk (b i₃) ∧
      ∀ i, i ≠ i₁ → i ≠ i₃ →
        coinvMap ε (psiBar b i₁ i₂ i₃ c (mu dag c δ) (nu dag c δ)) (Submodule.Quotient.mk (b i))
          = Submodule.Quotient.mk (b i) :=
  mapQ_action_basis ε χ₀ dag hdag b i₁ i₂ i₃ h₁₃ c δ hc₀ hc₁ le_rfl (kerSmul_le_comap ε _)

/-- Step (6) on `(V/V^(2))_𝒢 = M₁ / (R θ x̄₀ + (ker ε) M₁)`, for the free module on `x̄ᵢ = b i` and the
`c, μ, ν` of step (3), with `ψ̄` fixing `x̄_{i₀}`: `ȳ_{i₁} ↦ ȳ_{i₁} + ȳ_{i₂}`, and `ȳ_{i₃}` and every other
`ȳᵢ` are fixed. -/
theorem relCoinv_action_basis (ε χ₀ : R →ₐ[k] k) (dag : R → R) (hdag : ∀ a, ε (dag a) = χ₀ a)
    (b : Module.Basis ι R M₁) (θ : R) (i₀ i₁ i₂ i₃ : ι) (h₀₁ : i₀ ≠ i₁) (h₀₃ : i₀ ≠ i₃)
    (h₁₃ : i₁ ≠ i₃) (c δ : R) (hc₀ : χ₀ c = 0) (hc₁ : ε c = 1) :
    relMap ε b θ i₂ h₀₁ h₀₃ c (mu dag c δ) (nu dag c δ) (Submodule.Quotient.mk (b i₁))
        = Submodule.Quotient.mk (b i₁) + Submodule.Quotient.mk (b i₂) ∧
      relMap ε b θ i₂ h₀₁ h₀₃ c (mu dag c δ) (nu dag c δ) (Submodule.Quotient.mk (b i₃))
        = Submodule.Quotient.mk (b i₃) ∧
      ∀ i, i ≠ i₁ → i ≠ i₃ →
        relMap ε b θ i₂ h₀₁ h₀₃ c (mu dag c δ) (nu dag c δ) (Submodule.Quotient.mk (b i))
          = Submodule.Quotient.mk (b i) :=
  mapQ_action_basis ε χ₀ dag hdag b i₁ i₂ i₃ h₁₃ c δ hc₀ hc₁ (kerSmul_le_relKer ε b θ i₀)
    (relKer_le_comap_psiBar ε b θ i₂ h₀₁ h₀₃ c _ _)

end Basis

end Modules

end LogShellEdge.GroupRing
