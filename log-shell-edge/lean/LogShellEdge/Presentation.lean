import LogShellEdge.Coord
import LogShellEdge.Reuse.ShearRelation

/-!
# Lemma 3.2 (integral basis), Lemma 3.4, and the group-theoretic core of Lemma 4.1

* `lemma41_descends`: an automorphism `ψ` of a group `G` with `ψ(N) = N` for a normal subgroup `N` (in the
  note: the kernel of the maximal pro-`p` quotient of the normal subgroup generated by the `z_i`, which is
  characteristic) and fixing the class of the relation `r` induces an automorphism of
  `X = (G/N)/⟨⟨r⟩⟩`. `fixes_relation`: `ψ` fixes `r = r₀ · w` if it fixes `r₀` (the part made of
  `σ, τ, x₀, x₁`, the twisted product and the word `x₁'`) and the commutator product `w`. The topology
  (profinite groups, continuous maps) is not modelled.
* `lemma32_core`: the module computation of Lemma 3.2. In `A = ℤ_p^(d+2) / ℤ_p (h e₀ - p^s e₁)`
  (`s ≥ 1`), if `A` is torsion-free (local class field theory and `μ_p ⊄ K`), then `h` is a unit
  (the reused `SourceShearRelation.isUnit_of_relation`), `x̄₀ ∈ ⟨x̄₁⟩`, and `x̄₁, …, x̄_{d+1}` are linearly
  independent in `A`.
* `lemma34`: if `Tr(y_i) = 0` for `i ≠ ⋆`, `Tr(Λ) ⊆ p ℤ_p` and some element of `Λ` has trace in
  `p ℤ_p^×`, then `Tr(y_⋆) ∈ p ℤ_p^×`.
-/

set_option autoImplicit false

noncomputable section

namespace LogShellEdge

open LogShellEdge.ShearRelation

/-! ## Lemma 4.1 -/

/-- Lemma 4.1, group-theoretic core: `ψ` descends to `X = (G/N)/⟨⟨r̄⟩⟩` if `ψ(N) = N` and `ψ(r) = r`. -/
theorem lemma41_descends {G : Type*} [Group G] (N : Subgroup G) [N.Normal] (ψ : G ≃* G)
    (hN : N.map ψ.toMonoidHom = N) (r : G) (hr : ψ r = r) :
    ∃ α : (G ⧸ N) ⧸ Subgroup.normalClosure {(r : G ⧸ N)} ≃* (G ⧸ N) ⧸ Subgroup.normalClosure {(r : G ⧸ N)},
      ∀ x : G, α ((x : G ⧸ N) : (G ⧸ N) ⧸ Subgroup.normalClosure {(r : G ⧸ N)}) =
        ((ψ x : G ⧸ N) : (G ⧸ N) ⧸ Subgroup.normalClosure {(r : G ⧸ N)}) := by
  obtain ⟨ψ₁, hψ₁⟩ : ∃ ψ₁ : G ⧸ N ≃* G ⧸ N, ∀ x : G, ψ₁ (x : G ⧸ N) = (ψ x : G ⧸ N) :=
    ⟨QuotientGroup.congr N N ψ hN, fun x => QuotientGroup.congr_mk _ _ _ _ x⟩
  have hψ₁r : ψ₁ (r : G ⧸ N) = (r : G ⧸ N) := by rw [hψ₁, hr]
  have hR : (Subgroup.normalClosure {(r : G ⧸ N)}).map ψ₁.toMonoidHom =
      Subgroup.normalClosure {(r : G ⧸ N)} := by
    have := Subgroup.map_normalClosure {(r : G ⧸ N)} ψ₁.toMonoidHom ψ₁.surjective
    rw [this, Set.image_singleton]
    congr 2
  refine ⟨QuotientGroup.congr _ _ ψ₁ hR, fun x => ?_⟩
  rw [QuotientGroup.congr_mk, hψ₁]

/-- `ψ` fixes `r = r₀ * w` if it fixes `r₀` and `w`. -/
theorem fixes_relation {G : Type*} [Group G] (ψ : G ≃* G) (r₀ w : G) (h₀ : ψ r₀ = r₀) (hw : ψ w = w) :
    ψ (r₀ * w) = r₀ * w := by rw [map_mul, h₀, hw]

/-! ## Lemma 3.2 -/

variable {p : ℕ} [Fact p.Prime]

/-- Lemma 3.2, module computation. Coordinates: `0 ↦ x₀`, `1 ↦ x₁`, …, and the remaining coordinates
(`x₂, …, x_d, σ`). If `A = ℤ_p^ι / ⟨h e₀ - p^s e₁⟩` (`s ≥ 1`) is torsion-free then `h` is a unit, `x̄₀` lies
in the span of `x̄₁`, and the images of the basis vectors other than `e₀` are linearly independent. -/
theorem lemma32_core {ι : Type*} [DecidableEq ι] (i₀ i₁ : ι) (h01 : i₀ ≠ i₁) (h : ℤ_[p]) (s : ℕ)
    (hs : 1 ≤ s)
    (htf : ∀ (c : ℤ_[p]) (w : ι → ℤ_[p]), c ≠ 0 →
      c • w ∈ Submodule.span ℤ_[p] {Pi.single i₀ h - Pi.single i₁ ((p : ℤ_[p]) ^ s)} →
      w ∈ Submodule.span ℤ_[p] {Pi.single i₀ h - Pi.single i₁ ((p : ℤ_[p]) ^ s)}) :
    IsUnit h ∧
      (∃ t : ℤ_[p], Pi.single i₀ 1 - t • Pi.single i₁ 1 ∈
        Submodule.span ℤ_[p] {Pi.single i₀ h - Pi.single i₁ ((p : ℤ_[p]) ^ s)}) ∧
      (∀ a : ι → ℤ_[p], a i₀ = 0 →
        a ∈ Submodule.span ℤ_[p] {Pi.single i₀ h - Pi.single i₁ ((p : ℤ_[p]) ^ s)} → a = 0) := by
  have hu := isUnit_of_relation i₀ i₁ h01 h s hs htf
  refine ⟨hu, ?_, ?_⟩
  · -- `e₀ - h⁻¹ p^s e₁ = h⁻¹ (h e₀ - p^s e₁)`
    refine ⟨(↑hu.unit⁻¹ : ℤ_[p]) * (p : ℤ_[p]) ^ s, ?_⟩
    rw [Submodule.mem_span_singleton]
    refine ⟨(↑hu.unit⁻¹ : ℤ_[p]), ?_⟩
    have hinv : (↑hu.unit⁻¹ : ℤ_[p]) * h = 1 := hu.val_inv_mul
    ext i
    simp only [Pi.smul_apply, Pi.sub_apply, Pi.single_apply, smul_eq_mul]
    split_ifs with h1 h2 h2
    · subst h1; exact absurd h2 h01
    · subst h1; simp [hinv]
    · subst h2; ring
    · ring
  · intro a ha0 ha
    rw [Submodule.mem_span_singleton] at ha
    obtain ⟨c, rfl⟩ := ha
    have h0 : c * h = 0 := by
      have := ha0
      simp only [Pi.smul_apply, Pi.sub_apply, Pi.single_eq_same, Pi.single_eq_of_ne h01, smul_eq_mul,
        sub_zero] at this
      exact this
    have hc : c = 0 := by
      rcases mul_eq_zero.mp h0 with hc | hh
      · exact hc
      · exact absurd hh hu.ne_zero
    rw [hc, zero_smul]

/-! ## Lemma 3.4 -/

variable {V : Type*} [AddCommGroup V] [Module ℚ_[p] V] [Module ℤ_[p] V] [IsScalarTower ℤ_[p] ℚ_[p] V]
variable {ι : Type} [Fintype ι] [DecidableEq ι]

/-- Lemma 3.4: if `τ(y_i) = 0` for `i ≠ ⋆`, `τ(Λ) ⊆ ℤ_p` (i.e. `Tr(Λ) ⊆ p ℤ_p`) and some `x ∈ Λ` has
`‖τ x‖ = 1` (Lemma 2.2(d)), then `‖τ(y_⋆)‖ = 1`. -/
theorem lemma34 (y : Module.Basis ι ℚ_[p] V) (Λ : Submodule ℤ_[p] V)
    (hΛ : ∀ x, x ∈ Λ ↔ ∀ i, ‖y.repr x i‖ ≤ 1) (τ : V →ₗ[ℚ_[p]] ℚ_[p]) (star : ι)
    (hker : ∀ i, i ≠ star → τ (y i) = 0) (hint : ∀ x ∈ Λ, ‖τ x‖ ≤ 1)
    (x₀ : V) (hx₀ : x₀ ∈ Λ) (hτx₀ : ‖τ x₀‖ = 1) : ‖τ (y star)‖ = 1 := by
  have hy : y star ∈ Λ := by
    rw [hΛ]; intro j; rw [Module.Basis.repr_self, Finsupp.single_apply]; split_ifs <;> simp
  have key : τ x₀ = y.repr x₀ star * τ (y star) := by
    conv_lhs => rw [← y.sum_repr x₀]
    rw [map_sum]
    simp only [map_smul, smul_eq_mul]
    rw [Finset.sum_eq_single star]
    · intro i _ hi; rw [hker i hi, mul_zero]
    · intro h; exact absurd (Finset.mem_univ _) h
  have hc : ‖y.repr x₀ star‖ ≤ 1 := (hΛ x₀).1 hx₀ star
  refine le_antisymm (hint _ hy) ?_
  rw [key, norm_mul] at hτx₀
  by_contra hlt
  push_neg at hlt
  have : ‖y.repr x₀ star‖ * ‖τ (y star)‖ < 1 :=
    lt_of_le_of_lt (mul_le_of_le_one_left (norm_nonneg _) hc) hlt
  linarith

end LogShellEdge
